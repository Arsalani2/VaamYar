<button class="w-full sm:w-auto sm:flex-1 h-12 px-space-xl bg-primary text-on-primary font-headline-sm text-headline-sm rounded-xl flex items-center justify-center gap-2 hover:bg-secondary transition-all duration-150 shadow-sm active:scale-95" type="button">
<span class="">مرحله بعد</span>
<span class="material-symbols-outlined text-xl rotate-180" data-icon="arrow_forward">arrow_forward</span>
</button>
<!-- Back Action -->
<button class="w-full sm:w-auto h-12 px-space-lg bg-surface-container-lowest border border-outline-variant/60 text-on-surface-variant font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-2 hover:bg-surface-container-low transition-all duration-150 active:scale-95" type="button">
<span class="material-symbols-outlined text-xl" data-icon="arrow_forward">arrow_forward</span>
<span class="">بازگشت به گام قبل</span>
</button>
</div>
</footer>
<!-- Micro-interactions Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Icon Selector Handling
      const iconButtons = document.querySelectorAll('.preset-icon-btn');
      const previewIcon = document.getElementById('preview-icon-symbol');

      iconButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          iconButtons.forEach(b => {
            b.classList.remove('active', 'border-2', 'border-primary', 'bg-secondary-container/30', 'text-primary');
            b.classList.add('border', 'border-outline-variant/40', 'bg-surface-container-lowest', 'text-on-surface-variant');
          });

          btn.classList.add('active', 'border-2', 'border-primary', 'bg-secondary-container/30', 'text-primary');
          btn.classList.remove('border-outline-variant/40', 'bg-surface-container-lowest', 'text-on-surface-variant');

          const iconName = btn.getAttribute('data-icon-target');
          if (iconName && previewIcon) {
            previewIcon.textContent = iconName;
            previewIcon.setAttribute('data-icon', iconName);
          }
        });
      });

      // Palette Selector Handling
      const paletteButtons = document.querySelectorAll('.palette-btn');
      const paletteNameLabel = document.getElementById('selected-palette-name');

      paletteButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          paletteButtons.forEach(b => {
            const circle = b.querySelector('div');
            circle.classList.remove('ring-2', 'ring-primary', 'ring-offset-2', 'ring-offset-surface-container-lowest');
            circle.classList.add('border', 'border-outline-variant/50');
            const check = b.querySelector('.checkmark-icon');
            if (check) check.classList.add('opacity-0');
            const textLabel = b.querySelector('span:last-child');
            if (textLabel) {
              textLabel.classList.remove('text-primary', 'font-medium');
              textLabel.classList.add('text-on-surface-variant');
            }
          });

          const circle = btn.querySelector('div');
          circle.classList.add('ring-2', 'ring-primary', 'ring-offset-2', 'ring-offset-surface-container-lowest');
          circle.classList.remove('border', 'border-outline-variant/50');
          
          const check = btn.querySelector('.checkmark-icon') || btn.querySelector('.material-symbols-outlined');
          if (check) check.classList.remove('opacity-0');

          const textLabel = btn.querySelector('span:last-child');
          if (textLabel) {
            textLabel.classList.add('text-primary', 'font-medium');
            textLabel.classList.remove('text-on-surface-variant');
          }

          const paletteName = btn.getAttribute('data-color-name');
          if (paletteNameLabel && paletteName) {
            paletteNameLabel.textContent = paletteName;
          }
        });
      });
    });
  </script>


</body></html>